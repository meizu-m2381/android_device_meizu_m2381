type vendor_m2381_gesture, domain;
type vendor_m2381_gesture_exec, exec_type, vendor_file_type, file_type;
type vendor_sysfs_m2381_gesture, fs_type, sysfs_type;

init_daemon_domain(vendor_m2381_gesture)
allow vendor_m2381_gesture sysfs_type:dir search;
allow vendor_m2381_gesture vendor_sysfs_m2381_gesture:file rw_file_perms;
