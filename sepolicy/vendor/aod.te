type vendor_m2381_aod, domain;
type vendor_m2381_aod_exec, exec_type, vendor_file_type, file_type;
type vendor_sysfs_m2381_aod, fs_type, sysfs_type;
init_daemon_domain(vendor_m2381_aod)
allow vendor_m2381_aod vendor_file:file rx_file_perms;
allow vendor_m2381_aod sysfs:dir r_dir_perms;
allow vendor_m2381_aod sysfs_type:dir search;
allow vendor_m2381_aod vendor_sysfs_m2381_aod:file rw_file_perms;
get_prop(vendor_m2381_aod, m2381_aod_brightness_prop)
