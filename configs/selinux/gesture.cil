; Run the stock gesture mask helper under enforcing policy.
(type vendor_m2381_gesture)
(roletype object_r vendor_m2381_gesture)
(typeattributeset domain (vendor_m2381_gesture))
(type vendor_m2381_gesture_exec)
(roletype object_r vendor_m2381_gesture_exec)
(typeattributeset exec_type (vendor_m2381_gesture_exec))
(typeattributeset file_type (vendor_m2381_gesture_exec))
(typeattributeset vendor_file_type (vendor_m2381_gesture_exec))
(type vendor_sysfs_m2381_gesture)
(roletype object_r vendor_sysfs_m2381_gesture)
(typeattributeset fs_type (vendor_sysfs_m2381_gesture))
(typeattributeset sysfs_type (vendor_sysfs_m2381_gesture))
(allow init_33_0 vendor_m2381_gesture_exec (file (getattr open read execute map)))
(allow init_33_0 vendor_m2381_gesture (process (transition siginh rlimitinh)))
(dontaudit init_33_0 vendor_m2381_gesture (process (noatsecure)))
(typetransition init_33_0 vendor_m2381_gesture_exec process vendor_m2381_gesture)
(allow vendor_m2381_gesture vendor_m2381_gesture_exec (file (entrypoint getattr open read execute map)))
(allow vendor_m2381_gesture init_33_0 (process (sigchld)))
(allow vendor_m2381_gesture vendor_file_33_0 (file (getattr open read execute map)))
(allow vendor_m2381_gesture sysfs_type (dir (search)))
(allow vendor_m2381_gesture vendor_sysfs_m2381_gesture (file (getattr open read write)))
(allow vendor_init_33_0 vendor_sysfs_m2381_gesture (file (getattr setattr)))
(genfscon sysfs "/devices/platform/mx-gs/gesture_control" (u object_r vendor_sysfs_m2381_gesture ((s0) (s0))))
