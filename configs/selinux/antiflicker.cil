; LiveDisplay uses the system service manager. The composer client uses vndbinder.
(type vendor_m2381_antiflicker)
(roletype object_r vendor_m2381_antiflicker)
(typeattributeset domain (vendor_m2381_antiflicker))
(type vendor_m2381_antiflicker_exec)
(roletype object_r vendor_m2381_antiflicker_exec)
(typeattributeset exec_type (vendor_m2381_antiflicker_exec))
(typeattributeset file_type (vendor_m2381_antiflicker_exec))
(typeattributeset vendor_file_type (vendor_m2381_antiflicker_exec))
