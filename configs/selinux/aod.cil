; Device helper only controls the two AOD sysfs nodes.
(type vendor_m2381_aod)
(roletype object_r vendor_m2381_aod)
(typeattributeset domain (vendor_m2381_aod))
(type vendor_m2381_aod_exec)
(roletype object_r vendor_m2381_aod_exec)
(typeattributeset exec_type (vendor_m2381_aod_exec))
(typeattributeset file_type (vendor_m2381_aod_exec))
(typeattributeset vendor_file_type (vendor_m2381_aod_exec))
(type vendor_sysfs_m2381_aod)
(roletype object_r vendor_sysfs_m2381_aod)
(typeattributeset fs_type (vendor_sysfs_m2381_aod))
(typeattributeset sysfs_type (vendor_sysfs_m2381_aod))
(allow init_33_0 vendor_m2381_aod_exec (file (getattr open read execute map)))
(allow init_33_0 vendor_m2381_aod (process (transition siginh rlimitinh)))
(dontaudit init_33_0 vendor_m2381_aod (process (noatsecure)))
(typetransition init_33_0 vendor_m2381_aod_exec process vendor_m2381_aod)
(allow vendor_m2381_aod vendor_m2381_aod_exec (file (entrypoint getattr open read execute map)))
(allow vendor_m2381_aod init_33_0 (process (sigchld)))
(allow vendor_m2381_aod vendor_file_33_0 (file (getattr open read execute map)))
(allow vendor_m2381_aod sysfs_33_0 (dir (getattr open read search)))
(allow vendor_m2381_aod sysfs_type (dir (search)))
(allow vendor_m2381_aod vendor_sysfs_m2381_aod (file (getattr open read write)))
(allow vendor_m2381_aod m2381_aod_brightness_prop (file (getattr open read map)))
(genfscon sysfs "/kernel/display_drivers/aod_light_mode" (u object_r vendor_sysfs_m2381_aod ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/soc:qcom,dsi-display-primary/display/aod" (u object_r vendor_sysfs_m2381_aod ((s0) (s0))))
