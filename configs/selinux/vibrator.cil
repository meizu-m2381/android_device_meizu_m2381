; 原厂 API 33 CIL 保持马达节点 vib_strength_sysfs 标签。
; 源码 AIDL HAL 写入启停、gain 和 waveform；不扩大其他域的权限。
(allow hal_vibrator_default vib_strength_sysfs (file (open write getattr)))
(allow hal_vibrator_default vib_strength_sysfs (dir (search)))
; HAL 重启同一程序的工作模式时切换到独立域，遵守 HAL neverallow。
(type vendor_tiktap_worker)
(roletype object_r vendor_tiktap_worker)
(typeattributeset domain (vendor_tiktap_worker))
(allow hal_vibrator_default hal_vibrator_default_exec (file (getattr open read execute map)))
(allow hal_vibrator_default vendor_tiktap_worker (process (transition siginh rlimitinh sigkill)))
(dontaudit hal_vibrator_default vendor_tiktap_worker (process (noatsecure)))
(typetransition hal_vibrator_default hal_vibrator_default_exec process vendor_tiktap_worker)
(allow vendor_tiktap_worker hal_vibrator_default_exec (file (entrypoint open read execute getattr map)))
(allow vendor_tiktap_worker hal_vibrator_default (process (sigchld)))
(allow vendor_tiktap_worker hal_vibrator_default (fd (use)))
(allow vendor_tiktap_worker self (process (fork)))
(allow vendor_tiktap_worker vendor_file_33_0 (file (getattr open read execute map)))
(allow vendor_tiktap_worker logdw_socket_33_0 (sock_file (write)))
(allow vendor_tiktap_worker logd_33_0 (unix_dgram_socket (sendto)))
(allow hal_vibrator_default proc_tiktap_buf (file (open read write getattr map ioctl)))
(allowx hal_vibrator_default proc_tiktap_buf (ioctl file (0xff09 0xff0b)))
(allow vendor_tiktap_worker proc_tiktap_buf (file (open read write getattr map ioctl)))
(allowx vendor_tiktap_worker proc_tiktap_buf (ioctl file (0xff09 0xff0b)))
