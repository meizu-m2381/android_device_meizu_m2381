on post-fs-data
    mkdir /data/vendor/qwes 0755 system system

on early-boot
    start vendor.ssgtzd

service vendor.ssgtzd /vendor/bin/ssgtzd
    class late_start
    user system
    group system oem_2912
    disabled
    socket ssgtzd stream 0660 system oem_2912
    socket ssgtzd_opener stream 0660 system system
