<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="config_enableAuxCameras">true</bool>
    <!-- Camera 2 is the depth sensor; camera 4 is the logical combination.
         Offer the physical main camera (0) and ultrawide (3) as lenses. -->
    <string-array name="config_ignoredAuxCameraIds">
        <item>2</item>
        <item>4</item>
    </string-array>
    <!-- Stock metadata advertises 60 fps through Meizu vendor tables only.
         These regular video sessions were verified on all three cameras. -->
    <string-array name="config_additionalVideoConfigurations">
        <item>0</item> <item>hd|fhd|uhd</item> <item>60</item>
        <item>1</item> <item>hd|fhd|uhd</item> <item>60</item>
        <item>3</item> <item>hd|fhd|uhd</item> <item>60</item>
    </string-array>
</resources>
