service vendor.meizu.vibrator /vendor/bin/hw/android.hardware.vibrator-service.meizu
    class hal
    user system
    group system

on post-fs-data
    chown system system /sys/class/timed_output/vibrator/gain
    chmod 0660 /sys/class/timed_output/vibrator/gain
    write /sys/class/timed_output/vibrator/gain 0x80
    chown system system /sys/class/timed_output/vibrator/waveform
    chmod 0660 /sys/class/timed_output/vibrator/waveform
    write /sys/class/timed_output/vibrator/waveform 0x1

# 即使 HAL 异常退出，也不让原厂 RAM 循环波形持续播放。
on property:init.svc.vendor.meizu.vibrator=stopped
    write /sys/class/timed_output/vibrator/enable 0

on property:init.svc.vendor.meizu.vibrator=restarting
    write /sys/class/timed_output/vibrator/enable 0
