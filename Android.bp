soong_namespace {
}

// The GMS prebuilt is already a CAPEX, so PRODUCT_COMPRESSED_APEX cannot
// prevent it from needing /data at first boot.
java_genrule {
    name: "m2381_extservices_apex_file",
    srcs: ["//vendor/pixel/gms/common:com.google.android.extservices"],
    tools: ["deapexer"],
    out: ["com.google.android.extservices.apex"],
    cmd: "$(location deapexer) decompress --copy-if-uncompressed --input $(in) --output $(out)",
}

prebuilt_apex {
    name: "m2381_google_extservices",
    src: ":m2381_extservices_apex_file",
    filename: "com.google.android.extservices.m2381.apex",
    apps: ["GoogleExtServices"],
    overrides: [
        "com.android.extservices",
        "com.google.android.extservices",
    ],
}

// EGL's explicit egl/ path and DT_NEEDED must resolve to the same inode.
install_symlink {
    name: "m2381_adreno_egl_alias_32",
    vendor: true,
    installed_location: "lib/libEGL_adreno.so",
    symlink_target: "egl/libEGL_adreno.so",
}

install_symlink {
    name: "m2381_adreno_egl_alias_64",
    vendor: true,
    installed_location: "lib64/libEGL_adreno.so",
    symlink_target: "egl/libEGL_adreno.so",
}

install_symlink {
    name: "m2381_adreno_gles_alias_32",
    vendor: true,
    installed_location: "lib/libGLESv2_adreno.so",
    symlink_target: "egl/libGLESv2_adreno.so",
}

install_symlink {
    name: "m2381_adreno_gles_alias_64",
    vendor: true,
    installed_location: "lib64/libGLESv2_adreno.so",
    symlink_target: "egl/libGLESv2_adreno.so",
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/kiwi_v2/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "rfs_msm_mpss_readonly_mbnconfig_symlink",
    vendor: true,
    installed_location: "rfs/msm/mpss/readonly/mbnconfig",
    symlink_target: "/data/vendor/mbnconfig",
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_qti_hardware_wifi_wifilearner_interface",
    interfaces: [
        "vendor.qti.hardware.wifi.wifilearner@1.0::IWifiStats",
    ],
}
// 跨分区符号链接（由 blobs 的绝对软链转换而来）

install_symlink {
    name: "mz_symlink_01",
    vendor: true,
    installed_location: "app/CneApp/lib/arm64/libvndfwk_detect_jni.qti_vendor.so",
    symlink_target: "/vendor/lib64/libvndfwk_detect_jni.qti_vendor.so",
}

install_symlink {
    name: "mz_symlink_02",
    vendor: true,
    installed_location: "lib/modules",
    symlink_target: "/vendor_dlkm/lib/modules",
}

install_symlink {
    name: "mz_symlink_03",
    vendor: true,
    installed_location: "odm",
    symlink_target: "/odm",
}
